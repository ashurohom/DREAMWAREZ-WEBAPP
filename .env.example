# EmailJS Configuration (Optional Frontend Fallback)
# Sign up at https://www.emailjs.com/ to obtain service keys
VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# SMTP Email Notification Configuration (Nodemailer Backend)
# Gmail App Password can be generated from:
# Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
ADMIN_NOTIFICATION_EMAIL=ashitosh@dreamwarez.in

# Frontend Client Email Variables (Vite)
VITE_ADMIN_NOTIFICATION_EMAIL=ashitosh@dreamwarez.in
VITE_PUBLIC_CONTACT_EMAIL=info@dreamwarez.in
VITE_CAREERS_EMAIL=careers@dreamwarez.in
